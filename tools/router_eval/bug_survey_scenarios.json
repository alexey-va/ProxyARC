[
  {
    "id": "scenario_new_report_legacy_then_survey",
    "title": "Новый репорт → legacy bug; после тикета → survey",
    "description": "GrocerMC первый раз пишет про rtp без open ticket — одноразовый bug-agent. После createissueticket следующее сообщение идёт в survey.",
    "steps": [
      {
        "step": 1,
        "event": "player_message",
        "player": "GrocerMC",
        "message": "rtp не работает на survival",
        "meta": {},
        "open_ticket": null,
        "expect": {
          "use_survey": false,
          "agent_mode": "legacy_bug",
          "witness": false
        }
      },
      {
        "step": 2,
        "event": "agent_create_ticket",
        "player": "GrocerMC",
        "ticket_id": "RB-00010",
        "topic": "rtp не работает"
      },
      {
        "step": 3,
        "event": "player_message",
        "player": "GrocerMC",
        "message": "жал /rtp в мире биомов",
        "meta": {"reply_to_bot": true, "continuation_with_bot": true},
        "open_ticket": {"ticket_id": "RB-00010", "reporter": "GrocerMC", "title": "rtp"},
        "expect": {
          "use_survey": true,
          "agent_mode": "bug_survey",
          "primary": "GrocerMC",
          "witness": false,
          "session_ticket": "RB-00010"
        }
      }
    ]
  },
  {
    "id": "scenario_global_inquiry_witness_joins",
    "title": "Глобальный опрос → второй игрок подтверждает баг",
    "description": "Репортёр заводит тикет, спрашивает всех через sendglobalmessage. Koxae отвечает «да у меня тоже» — попадает в то же расследование как witness.",
    "steps": [
      {
        "step": 1,
        "event": "setup_survey_with_ticket",
        "primary": "GrocerMC",
        "ticket_id": "RB-00020",
        "topic": "rtp"
      },
      {
        "step": 2,
        "event": "agent_global_message",
        "primary": "GrocerMC",
        "message": "у кого rtp не пашет на survival?"
      },
      {
        "step": 3,
        "event": "player_message",
        "player": "Koxae",
        "message": "да у меня тоже не работает",
        "meta": {"reply_to_bot": true, "continuation_with_bot": true, "seconds_since_bot": 8},
        "open_ticket": null,
        "expect": {
          "use_survey": true,
          "agent_mode": "bug_survey",
          "primary": "GrocerMC",
          "witness": true,
          "participants_include": ["GrocerMC", "Koxae"]
        }
      },
      {
        "step": 4,
        "event": "player_message",
        "player": "Koxae",
        "message": "жму /rtp в мире биомов ничего",
        "meta": {"reply_to_bot": true, "continuation_with_bot": true},
        "open_ticket": null,
        "expect": {
          "use_survey": true,
          "witness": true,
          "primary": "GrocerMC"
        }
      }
    ]
  },
  {
    "id": "scenario_witness_short_confirm_without_reply_meta",
    "title": "Witness: короткое «да» без reply_to_bot после глобала",
    "description": "После sendglobalmessage игрок пишет короткое подтверждение в глобал без явного reply_to_bot — всё равно линкуется по эвристике short_confirm.",
    "steps": [
      {
        "step": 1,
        "event": "agent_global_message",
        "primary": "GrocerMC",
        "message": "у кого палка строителя не пашет?"
      },
      {
        "step": 2,
        "event": "player_message",
        "player": "Koxae",
        "message": "да",
        "meta": {},
        "open_ticket": null,
        "expect": {
          "use_survey": true,
          "witness": true,
          "primary": "GrocerMC"
        }
      }
    ]
  },
  {
    "id": "scenario_global_inquiry_ignored_unrelated_chat",
    "title": "После глобала посторонний флуд не линкуется",
