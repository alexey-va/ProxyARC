  {
    "id": "scenario_close_ticket_ends_session",
    "title": "Закрытие тикета закрывает survey",
    "description": "После updateissueticket status=closed сессия снимается; следующее сообщение — снова legacy если нет open ticket.",
    "steps": [
      {
        "step": 1,
        "event": "setup_survey_with_ticket",
        "primary": "GrocerMC",
        "ticket_id": "RB-00030",
        "topic": "rtp fixed"
      },
      {
        "step": 2,
        "event": "close_survey",
        "primary": "GrocerMC",
        "reason": "ticket_closed"
      },
      {
        "step": 3,
        "event": "player_message",
        "player": "GrocerMC",
        "message": "другой баг — палка не работает",
        "meta": {},
        "open_ticket": null,
        "expect": {
          "use_survey": false,
          "agent_mode": "legacy_bug"
        }
      }
    ]
  },
  {
    "id": "scenario_three_witnesses_append_dialog",
    "title": "Три witness — диалог в тикет",
    "description": "Несколько игроков подтверждают баг после глобала; enrich_ticket_append собирает полный контекст для Discord.",
    "steps": [
      {
        "step": 1,
        "event": "setup_survey_with_ticket",
        "primary": "GrocerMC",
        "ticket_id": "RB-00040",
        "topic": "farm bug"
      },
      {
        "step": 2,
        "event": "agent_global_message",
        "primary": "GrocerMC",
        "message": "у кого кокос не растёт?"
      },
      {
        "step": 3,
        "event": "player_message",
        "player": "Koxae",
        "message": "да не растёт",
        "meta": {"reply_to_bot": true},
        "open_ticket": null,
        "expect": {"witness": true, "primary": "GrocerMC"}
      },
      {
        "step": 4,
        "event": "player_message",
        "player": "yarostuf",
        "message": "у меня тоже на survival",
        "meta": {"reply_to_bot": true},
        "open_ticket": null,
        "expect": {"witness": true, "primary": "GrocerMC"}
      },
      {
        "step": 5,
        "event": "assert_participants",
        "primary": "GrocerMC",
        "participants": ["GrocerMC", "Koxae", "yarostuf"]
      },
      {
        "step": 6,
        "event": "assert_ticket_append",
        "trigger_message": "у меня тоже на survival",
        "agent_text": "yarostuf подтвердил на survival",
        "dialog_lines": [
          "игрок: rtp не работает",
          "скорен (глобал): у кого кокос не растёт?",
          "игрок: да не растёт",
          "игрок: у меня тоже на survival"
        ],
        "must_contain": ["**Игрок:**", "**Диалог:**", "yarostuf", "кокос"]
      }
    ]
  },
  {
    "id": "scenario_primary_not_witness_to_self_after_global",
    "title": "Репортёр после своего глобала — не witness сам себе",
    "description": "Primary продолжает расследование как primary, не как witness linked via global inquiry.",
    "steps": [
      {
        "step": 1,
        "event": "setup_survey_with_ticket",
        "primary": "GrocerMC",
        "ticket_id": "RB-00050",
        "topic": "builder stick"
      },
      {
        "step": 2,
        "event": "agent_global_message",
        "primary": "GrocerMC",
        "message": "у кого палка не пашет?"
      },
      {
        "step": 3,
        "event": "player_message",
        "player": "GrocerMC",
        "message": "ну у меня точно не пашет",
        "meta": {"continuation_with_bot": true},
        "open_ticket": {"ticket_id": "RB-00050", "reporter": "GrocerMC"},
        "expect": {
          "use_survey": true,
          "primary": "GrocerMC",
          "witness": false
        }
      }
    ]
  },
  {
    "id": "scenario_builder_stick_realistic_flow",
    "title": "Реалистичный flow Koxae / палка строителя",
    "description": "Первый vague репорт → legacy + PM; детали → survey; глобал; закрытие когда разобрались.",
    "steps": [
      {
        "step": 1,
        "event": "player_message",
        "player": "Koxae",
        "message": "помогитя баг",
        "meta": {},
        "open_ticket": null,
        "expect": {"use_survey": false, "agent_mode": "legacy_bug"}
      },
      {
        "step": 2,
        "event": "player_message",
        "player": "Koxae",
        "message": "не растёт кокос",
        "meta": {"reply_to_bot": true},
        "open_ticket": null,
        "expect": {"use_survey": false, "agent_mode": "legacy_bug"}
      },
      {
        "step": 3,
        "event": "agent_create_ticket",
        "player": "Koxae",
        "ticket_id": "RB-00003",
        "topic": "кокос / палка"
      },
      {
        "step": 4,
        "event": "player_message",
        "player": "Koxae",
        "message": "Грос, палка строителя не пашет",
        "meta": {},
        "open_ticket": {"ticket_id": "RB-00003", "reporter": "Koxae"},
        "expect": {"use_survey": true, "primary": "Koxae", "witness": false}
      },
      {
        "step": 5,
        "event": "player_message",
        "player": "Koxae",
        "message": "а. в левую руку блок надо было взять. поняла",
        "meta": {"reply_to_bot": true, "continuation_with_bot": true},
        "open_ticket": {"ticket_id": "RB-00003", "reporter": "Koxae"},
        "expect": {"use_survey": true, "primary": "Koxae"}
      },
      {
        "step": 6,
        "event": "close_survey",
        "primary": "Koxae",
        "reason": "ticket_closed"
      }
    ]
  }
]
