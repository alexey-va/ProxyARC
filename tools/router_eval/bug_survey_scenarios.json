  {
    "id": "scenario_global_inquiry_expired",
    "title": "Глобальный опрос протух — witness не линкуется",
    "description": "Если прошло больше global-inquiry-window-sec, ответ другого игрока не привязывается автоматически.",
    "steps": [
      {
        "step": 1,
        "event": "agent_global_message",
        "primary": "GrocerMC",
        "message": "у кого rtp?"
      },
      {
        "step": 2,
        "event": "advance_time_sec",
        "seconds": 400
      },
      {
        "step": 3,
        "event": "player_message",
        "player": "Koxae",
        "message": "да у меня тоже",
        "meta": {"reply_to_bot": true},
        "open_ticket": null,
        "expect": {
          "use_survey": false,
          "investigation_resolved": false
        }
      }
    ]
  },
  {
